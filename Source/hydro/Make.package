CEXE_headers += slope.H
CEXE_headers += reconstruction.H
CEXE_sources += trace_piecewise_linear.cpp
CEXE_sources += trace_piecewise_parabolic.cpp

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += order4_scheme.cpp
  CEXE_sources += fourth_order_center.cpp
  CEXE_headers += fourth_order_center.H
endif

ifneq ($(DIM), 1)
  CEXE_sources += trans.cpp
endif

