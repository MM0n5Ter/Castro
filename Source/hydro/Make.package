
ifneq ($(USE_MHD),TRUE)
  CEXE_sources += HydroSim_hydro.cpp
  CEXE_sources += HydroSim_corner_upwind_hydro.cpp
endif

CEXE_sources += HydroSim_corner_upwind.cpp
