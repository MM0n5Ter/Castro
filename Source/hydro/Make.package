ifneq ($(USE_MHD),TRUE)
  CEXE_sources += primitive_state.cpp
  CEXE_sources += HydroSim_corner_upwind_hydro.cpp
endif

CEXE_sources += face_states.cpp
CEXE_sources += flux_update.cpp
CEXE_headers += transport_util.H
CEXE_sources += transport_util.cpp

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += HydroSim_lines_hydro.cpp
endif

ifeq ($(USE_HYBRID_MOMENTUM), TRUE)
  CEXE_headers += hybrid.H
  CEXE_sources += HydroSim_hybrid.cpp
endif

CEXE_headers += ppm.H
CEXE_sources += riemann.cpp
CEXE_headers += two_wave_solvers.H
CEXE_headers += shock_pair_solvers.H
CEXE_headers += solver_constants.H
CEXE_headers += solver_types.H
CEXE_headers += limiters.H
CEXE_headers += reconstruction.H
CEXE_sources += edge_tracing.cpp

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += fourth_order_states.cpp
  CEXE_sources += fourth_order_ops.cpp
  CEXE_headers += fourth_order_center.H
endif

ifneq ($(DIM), 1)
  CEXE_sources += trans.cpp
endif
