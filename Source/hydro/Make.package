CEXE_headers += flatten.H

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += HydroSim_lines_hydro.cpp
endif

ifeq ($(USE_HYBRID_MOMENTUM), TRUE)
  CEXE_headers += hybrid.H
  CEXE_sources += HydroSim_hybrid.cpp
endif

ifeq ($(USE_RAD), TRUE)
  CEXE_sources += HydroSim_corner_rad.cpp
endif

CEXE_headers += ppm.H
