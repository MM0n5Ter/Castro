ifneq ($(USE_MHD),TRUE)
  CEXE_sources += primitive_state.cpp
  CEXE_sources += ctu_hydro_update.cpp
endif

CEXE_sources += face_states.cpp
CEXE_sources += flux_update.cpp
CEXE_headers += primitive_conversion.H
CEXE_sources += hydro_cell_ops.cpp

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += mol_hydro_update.cpp
endif

ifeq ($(USE_HYBRID_MOMENTUM), TRUE)
  CEXE_headers += hybrid_momentum.H
  CEXE_sources += hybrid_momentum.cpp
endif

CEXE_headers += parabolic_profile.H
CEXE_sources += godunov_flux.cpp
CEXE_headers += approximate_riemann.H
CEXE_headers += iterative_riemann.H
CEXE_headers += solver_constants.H
CEXE_headers += riemann_states.H
CEXE_headers += limiters.H
CEXE_headers += stencil_tools.H
CEXE_sources += edge_tracing.cpp

ifeq ($(USE_TRUE_SDC),TRUE)
  CEXE_sources += fourth_order_states.cpp
  CEXE_sources += fourth_order_ops.cpp
  CEXE_headers += fourth_order_stencils.H
endif

ifneq ($(DIM), 1)
  CEXE_sources += transverse_terms.cpp
endif
