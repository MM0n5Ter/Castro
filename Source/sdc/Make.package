CEXE_headers += HydroSim_deferred.H

CEXE_sources += deferred_util.cpp

ifneq ($(USE_GPU), TRUE)
  CEXE_sources += HydroSim_deferred.cpp
  CEXE_headers += HydroSim_deferred_util.H
ifeq ($(USE_REACT), TRUE)
  CEXE_headers += deferred_react_util.H
  CEXE_headers += deferred_newton_solve.H
  CEXE_headers += deferred_dogleg_solve.H
  CEXE_headers += deferred_stiff_solve.H
endif
endif
