damping_target_y_velocity     Real          0.0                SPONGE

# Target z-velocity for the sponge to drive to
damping_target_z_velocity     Real          0.0                SPONGE

# Timescale on which the sponge operates
damping_timescale             Real         -1.0                SPONGE


