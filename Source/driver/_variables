# this is the list of variables indices that HydroSim will use for
# accessing various state arrays.  We will keep them in the order that
# they are specified here.

#  descriptive-name      name  also-adds-to                             count              if-def

# the conserved variable state
@set: conserved NUM_STATE
   density                URHO      NSRC                                  1                 None
   x-momentum             UMX       NSRC                                  1                 None
   y-momentum             UMY       NSRC                                  1                 None
   z-momentum             UMZ       NSRC                                  1                 None
   radial-momentum        UMR       NSRC                                  1                 HYBRID_MOMENTUM
   angular-momentum       UML       NSRC                                  1                 HYBRID_MOMENTUM
   perpendicular-momentum UMP       NSRC                                  1                 HYBRID_MOMENTUM
   energy-density         UEDEN     NSRC                                  1                 None
   internal-energy        UEINT     NSRC                                  1                 None
   temperature            UTEMP     NSRC                                  1                 None
   advected               UADV       [(NSRC, CONS_SPECIES_HAVE_SOURCES)]   NumAdv            None
   species                USPEC       [(NSRC, CONS_SPECIES_HAVE_SOURCES)]   NumSpec           None
   auxiliary              UAUXV       [(NSRC, CONS_SPECIES_HAVE_SOURCES)]   NumAux            None
   shock                  USHOCK      None                                  1                 SHOCK_VAR
   mu_p                   UMU_P      None                                  1                 NSE_NET
   mu_n                   UMU_N      None                                  1                 NSE_NET

# the primitive variable state
@set: primitive NQ
   density                QRHO      [NQTHERM, NQSRC]                        1                 None
   x-velocity             QU        [NQTHERM, NQSRC]                        1                 None
   y-velocity             QV        [NQTHERM, NQSRC]                        1                 None
   z-velocity             QW        [NQTHERM, NQSRC]                        1                 None
   gamma_c                QGAM1P       [NQTHERM, NQSRC]                        1                 TRUE_SDC
   pressure               QPRES     [NQTHERM, NQSRC]                        1                 None
   rho-e                  QRHOEI    [NQTHERM, NQSRC]                        1                 None
   B-x                    QMAGX     [NQTHERM, NQSRC]                        1                 MHD
   B-y                    QMAGY     [NQTHERM, NQSRC]                        1                 MHD
   B-z                    QMAGZ     [NQTHERM, NQSRC]                        1                 MHD
   temperature            QTEMP     [NQTHERM, NQSRC]                        1                 None
   total-pressure         QPTOTAL     NQTHERM                                 1                 RADIATION
   total-pressure         QPTOTAL     NQTHERM                                 1                 MHD
   total-reint            QRHOEITOT   NQTHERM                                 1                 RADIATION
   radiation              QERAD      NQTHERM                                 NGROUPS           RADIATION
   advected               QADV       None                                    NumAdv            None
   species                QSPEC       None                                    NumSpec           None
   auxiliary              QAUXV       None                                    NumAux            None


# the auxiliary quantities
@set: auxiliary NQAUX
   gamma_c                QGAM1     None            1                   None
   sound-speed            QC        None            1                   None
   gamma_c-gas            QGAM1GAS    None            1                   RADIATION
   sound-speed-gas        QCSNDGAS       None            1                   RADIATION
   flux-limiter           QFLXLIM     None            NGROUPS             RADIATION


# godunov interface states
@set: godunov NIFC
   x-velocity             IFCU       None            1                   None
   y-velocity             IFCV       None            1                   None
   z-velocity             IFCW       None            1                   None
   pressure               IFCPRES    None            1                   None
   density                IFCRHO     None            1                   HYBRID_MOMENTUM
   flux-limiter           IFCFLXLIM    None            NGROUPS             RADIATION
   radiation              IFCERAD   None            NGROUPS             RADIATION


