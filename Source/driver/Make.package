
CEXE_sources += HydroSim.cpp
CEXE_sources += runtime_params.cpp
CEXE_sources += HydroSim_advance.cpp
CEXE_sources += HydroSim_advance_ctu.cpp
ifeq ($(USE_TRUE_SDC), TRUE)
ifneq ($(USE_GPU), TRUE)
  CEXE_sources += HydroSim_advance_sdc.cpp
endif
endif
CEXE_sources += HydroSim_setup.cpp
CEXE_sources += HydroSim_io.cpp
CEXE_sources += HydroSimBuilder.cpp
CEXE_sources += main.cpp

CEXE_headers += HydroSim.H
CEXE_headers += hydrosim_limits.H
CEXE_headers += HydroSim_io.H
CEXE_headers += state_indices.H
CEXE_headers += runtime_parameters.H
CEXE_sources += quantity_sums.cpp
CEXE_sources += tally_integrated_quantities.cpp

CEXE_headers += Derive.H
CEXE_sources += Derive.cpp

CEXE_headers += HydroSim_generic_fill.H
CEXE_sources += HydroSim_generic_fill.cpp

CEXE_headers += HydroSim_helpers.H
CEXE_headers += global.H
CEXE_headers += HydroSim_math.H

NEED_MGUTIL =

ifeq ($(USE_GRAV), TRUE)
  NEED_MGUTIL = TRUE
endif

ifeq ($(USE_DIFFUSION), TRUE)
  NEED_MGUTIL = TRUE
endif

ifdef NEED_MGUTIL
  CEXE_sources += SolverUtils.cpp
  CEXE_headers += SolverUtils.H
endif

CEXE_headers += timestep.H
CEXE_sources += timestep.cpp
