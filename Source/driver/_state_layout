# this is the list of variables indices that HydroSim will use for
# accessing various state arrays.  We will keep them in the order that
# they are specified here.

#  descriptive-name      name  also-adds-to                             count              if-def

# the conserved variable state
@set: conserved NUM_STATE
   density                URHO      NUM_SOURCE                                  1                 None
   x-momentum             UMX       NUM_SOURCE                                  1                 None
   y-momentum             UMY       NUM_SOURCE                                  1                 None
   z-momentum             UMZ       NUM_SOURCE                                  1                 None
   radial-momentum        UMR       NUM_SOURCE                                  1                 HYBRID_MOMENTUM
   angular-momentum       UML       NUM_SOURCE                                  1                 HYBRID_MOMENTUM
   perpendicular-momentum UMP       NUM_SOURCE                                  1                 HYBRID_MOMENTUM
   energy-density         UEDEN     NUM_SOURCE                                  1                 None
   internal-energy        UEINT     NUM_SOURCE                                  1                 None
   temperature            UTEMP     NUM_SOURCE                                  1                 None
   advected               UFA       [(NUM_SOURCE, CONS_SPECIES_HAVE_SOURCES)]   NumAdvected            None
   species                UFS       [(NUM_SOURCE, CONS_SPECIES_HAVE_SOURCES)]   NumSpec           None
   auxiliary              UFX       [(NUM_SOURCE, CONS_SPECIES_HAVE_SOURCES)]   NumAux            None
   shock                  UFLAG_SHOCK      None                                  1                 SHOCK_VAR
   mu_p                   UPROTON_MU      None                                  1                 NSE_NET
   mu_n                   UNEUTRON_MU      None                                  1                 NSE_NET

# the primitive variable state
@set: primitive NQ
   density                QRHO      [NQPRIMBASE, NQSOURCE]                        1                 None
   x-velocity             QU        [NQPRIMBASE, NQSOURCE]                        1                 None
   y-velocity             QV        [NQPRIMBASE, NQSOURCE]                        1                 None
   z-velocity             QW        [NQPRIMBASE, NQSOURCE]                        1                 None
   gamma1_var                QGC       [NQPRIMBASE, NQSOURCE]                        1                 TRUE_SDC
   pressure               QPRES     [NQPRIMBASE, NQSOURCE]                        1                 None
   rho-e                  QEINTDENS    [NQPRIMBASE, NQSOURCE]                        1                 None
   B-x                    QBFIELDX     [NQPRIMBASE, NQSOURCE]                        1                 MHD
   B-y                    QBFIELDY     [NQPRIMBASE, NQSOURCE]                        1                 MHD
   B-z                    QBFIELDZ     [NQPRIMBASE, NQSOURCE]                        1                 MHD
   temperature            QTEMP     [NQPRIMBASE, NQSOURCE]                        1                 None
   total-pressure         QPTOTAL     NQPRIMBASE                                 1                 RADIATION
   total-pressure         QPTOTAL     NQPRIMBASE                                 1                 MHD
   total-internal_e            QETOTDENS   NQPRIMBASE                                 1                 RADIATION
   radiation              QRADENG      NQPRIMBASE                                 NGROUPS           RADIATION
   advected               QFA       None                                    NumAdvected            None
   species                QFS       None                                    NumSpec           None
   auxiliary              QFX       None                                    NumAux            None


# the auxiliary quantities
@set: auxiliary NQEXTRAQ
   gamma1_var                QGAMMA1     None            1                   None
   sound-speed            QC        None            1                   None
   gamma1_var-gas            QGAMMA1G    None            1                   RADIATION
   sound-speed-gas        QCG       None            1                   RADIATION
   flux-limiter           QFLUXLIM     None            NGROUPS             RADIATION


# godunov interface states
@set: godunov NGDSTATE
   x-velocity             GDU       None            1                   None
   y-velocity             GDV       None            1                   None
   z-velocity             GDW       None            1                   None
   pressure               GDPRESSURE    None            1                   None
   density                GDDENSITY     None            1                   HYBRID_MOMENTUM
   flux-limiter           GDFLUXLIM    None            NGROUPS             RADIATION
   radiation              GDRADENG   None            NGROUPS             RADIATION


