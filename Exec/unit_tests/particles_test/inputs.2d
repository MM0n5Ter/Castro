# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 100000
stop_time = 6.28318531
#stop_time = 3.1415926535

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0    0
geometry.coord_sys   = 0    # 0 = Cartesian
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 1.0  1.0
amr.n_cell           = 128  128

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  2   2
hydrosim.hi_bc       =  2   2

# WHICH PHYSICS
hydrosim.do_hydro = 0
hydrosim.do_react = 0
hydrosim.do_gravity_flag = 0
hydrosim.enable_tracer_particles = 1

# PARTICLES
particles.particle_seed_file    = particle_file   # initial position of particles
#particles.particle_resume_file = xxxxx           # we can add new particles at restart
particles.snapshot_dir         = particle_dir    # directory for output
particles.snapshot_density     = 1
particles.snapshot_temperature = 1
particles.v                     = 1               # verbosity

# TIME STEP CONTROL

hydrosim.cfl            = 0.7     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1    # scale back initial timestep
hydrosim.change_max     = 1.1     # maximum increase in dt over successive steps
hydrosim.constant_dt = 1.e-2

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 32

amr.refine_criteria = temperr tempgrad

amr.refine.temperr.value_greater = 1.1
amr.refine.temperr.field_name = Temp
amr.refine.temperr.max_level = 3

amr.refine.tempgrad.gradient = 0.1
amr.refine.tempgrad.field_name = Temp
amr.refine.tempgrad.max_level = 3

# CHECKPOINT FILES
amr.check_file      = particles_chk     # root name of checkpoint file
amr.check_int       = 1000     # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = particles_plt
amr.plot_int        = 100
amr.derive_plot_vars=ALL

# PROBLEM PARAMETERS
problem.vel_amp = 1.0e0

# EOS
eos.eos_assume_neutral = 1
