# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 10000
stop_time =  0.01
#stop_time =  0.02
#stop_time =  0.03
#stop_time =  0.04
#stop_time =  0.05
#stop_time =  0.06
#stop_time =  0.065

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0 0
geometry.coord_sys   = 1
geometry.prob_lo     = 0.   0.
geometry.prob_hi     = 7.5e8 15.e8

amr.n_cell           = 384 384
amr.n_cell           = 384 768

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  3 2
hydrosim.hi_bc       =  2 2

# WHICH PHYSICS
hydrosim.do_hydro      = 1
hydrosim.do_react      = 0
hydrosim.enable_extra_source   = 0
hydrosim.do_damping_zone     = 0
hydrosim.ppm_recon_kind      = 1
hydrosim.do_gravity_flag       = 1
gravity.gravity_model_name = MonopoleGrav
gravity.radial_bin_ratio      = 4
gravity.radial_bin_ratio      = 1

# RELEVANT FOR EOS
hydrosim.small_temp    = 1.e-3
hydrosim.small_dens    = 1.e-6

# TIME STEP CONTROL
hydrosim.cfl            = 0.5     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.05    # scale back initial timestep

# SPONGE
hydrosim.damping_lower_density = 1.0e-3
hydrosim.damping_upper_density = 1.0e-3
hydrosim.damping_timescale = 1.0e-3

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 0       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp
#amr.grid_log        = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 96
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

amr.refine_criteria = dengrad

amr.refine.dengrad.gradient = 1.0e7
amr.refine.dengrad.field_name = density
amr.refine.dengrad.max_level = 3

# CHECKPOINT FILES
amr.check_file      = chk_2d_  # root name of checkpoint file
amr.check_int       = 10000          # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = plt_2d_  # root name of plotfile
amr.plot_int        = 10000         # number of timesteps between plotfiles
amr.derive_plot_vars = NONE

# PROBLEM PARAMETERS
problem.rho_0 = 1.e9
problem.r_0   = 6.5e8
problem.p_0   = 1.e15
problem.rho_ambient = 1.0e-5
problem.smooth_delta = 4.e6

problem.center_x = 0.0e8
problem.center_y = 7.5e8

# EOS
eos.eos_gamma = 1.66666
eos.eos_assume_neutral = 1
