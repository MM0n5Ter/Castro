# ------------------  INPUTS TO MAIN PROGRAM  -------------------

amr.plot_files_output = 1
amr.checkpoint_files_output = 1

max_step = 100000
stop_time = 1.0

geometry.is_periodic = 0 0 0
geometry.coord_sys = 0           # cartesian

geometry.prob_lo   =  0.   0.   0.
geometry.prob_hi   =  5.e8 5.e8 5.e8

amr.n_cell         =  64  64  64 

amr.max_level      = 0       # maximum level number allowed

hydrosim.lo_bc       =  2 2 2
hydrosim.hi_bc       =  2 2 2

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<

hydrosim.do_hydro = 1
hydrosim.do_gravity_flag  = 1
hydrosim.do_react = 0
hydrosim.do_damping_zone = 1

hydrosim.ppm_recon_kind = 1
hydrosim.use_shock_flatten = 0

gravity.gravity_model_name = MonopoleGrav
gravity.radial_bin_ratio = 2
hydrosim.gravity_source_mode = 4

hydrosim.cfl            = 0.9     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep by this factor
hydrosim.change_max     = 1.05    # factor by which dt is allowed to change each timestep
hydrosim.sum_step_period   = 0       # timesteps between computing and printing volume averages

hydrosim.damping_upper_density = 1.e4
hydrosim.damping_lower_density = 1.e2
hydrosim.damping_timescale     = 1.e-3

#amr.ref_ratio       = 2 2 2 2 # refinement ratio
#amr.regrid_int      = 10000   # how often to regrid
#amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est
#amr.grid_eff        = 0.7     # what constitutes an efficient grid

amr.refine_criteria = denerr

amr.refine.denerr.value_greater = 1.0e0
amr.refine.denerr.field_name = density
amr.refine.denerr.max_level = 10

amr.check_file      = chk     # root name of checkpoint file
amr.check_int       = 100     # number of timesteps between checkpoints
amr.plot_file       = plt     # root name of plot file
amr.plot_int        = 50     # number of timesteps between plotfiles

amr.max_grid_size   = 32       # maximum grid size allowed -- used to control parallelism
amr.blocking_factor = 16       # block factor in grid generation

amr.v               = 1       # control verbosity in Amr.cpp
hydrosim.v            = 1       # control verbosity in HydroSim.cpp

amr.derive_plot_vars = density x_velocity y_velocity z_velocity Temp pressure B_x B_y B_z #Div_B

problem.model_name =  "WD_rhoc_2.e9_M_1.1.hse.2560"
