# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 0

#if AMREX_SPACEDIM == 2

geometry.coord_sys   =  1
geometry.prob_lo     =  0.0   -1.6e9
geometry.prob_hi     =  1.6e9  1.6e9
amr.n_cell           =  64     128
hydrosim.lo_bc         =  3      2
hydrosim.hi_bc         =  2      2

#elif AMREX_SPACEDIM == 3

geometry.coord_sys   =  0
geometry.prob_lo     = -1.6e9 -1.6e9 -1.6e9
geometry.prob_hi     =  1.6e9  1.6e9  1.6e9
amr.n_cell           =  128    128    128
hydrosim.lo_bc         =  2      2      2
hydrosim.hi_bc         =  2      2      2

#endif

amr.max_level        = 0
amr.ref_ratio        = 2 2 2 2 2 2 2 2 2 2 2
amr.n_error_buf      = 2 2 2 2 2 0 0 0 0 0 0
amr.blocking_factor  = 16
amr.max_grid_size    = 64

hydrosim.tagging_radius_cap = 0.6

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_gravity_flag  = 1
hydrosim.do_frame_spin = 1
hydrosim.spin_period = 100.0

hydrosim.do_equilibrium_start = 1
hydrosim.scf_peak_density = 1.3519e6
hydrosim.scf_equator_radius = 1.1e9
hydrosim.scf_pole_radius = 9.571e8
hydrosim.scf_residual_tol = 1.e-4

# GRAVITY
gravity.gravity_model_name = PoissonGrav # Full self-gravity with the Poisson equation
gravity.multipole_order_cap = 6    # Multipole expansion includes terms up to r**(-multipole_order_cap)

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing integrals
amr.data_log          = grid_diag.out

hydrosim.v = 1
amr.v = 1

# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file        = chk      # root name of checkpoint file
amr.check_int         = 1        # timesteps between checkpoints

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = plt      # root name of plotfile
amr.plot_per          = 1        # timesteps between plotfiles
amr.derive_plot_vars  = ALL

# refinement

amr.refine_criteria = denerr

amr.refine.denerr.max_level = 14
amr.refine.denerr.value_greater = 1.e6
amr.refine.denerr.field_name = density

