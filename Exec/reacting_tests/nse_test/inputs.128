# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 15000
stop_time =  0.032

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 1 1 1
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0     0     0
geometry.prob_hi     = 2.e7  2.e7  2.e7
amr.n_cell           = 128   128   128


# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  0   0   0
hydrosim.hi_bc       =  0   0   0

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1

hydrosim.ppm_recon_kind = 1
hydrosim.ppm_temp_mode = 0

hydrosim.use_shock_flatten = 1

hydrosim.riemann_method = 0

hydrosim.small_temp     = 1.e7

hydrosim.time_scheme = 3

# TIME STEP CONTROL
hydrosim.cfl            = 0.8     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 1.0     # scale back initial timestep
hydrosim.change_max     = 1.1     # scale back initial timestep
hydrosim.constant_dt = 1.e-4

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp
#amr.grid_log        = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.checkpoint_files_output = 0
amr.check_file      = nse_test_128_chk  # root name of checkpoint file
amr.check_int       = 300         # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = nse_test_128_plt  # root name of plotfile
amr.plot_per = 0.24
amr.derive_plot_vars = ALL

# problem initialization

problem.T0 = 5.e9
problem.dT_fact = 0.2
problem.rho0 = 1.e9
problem.L_pert = 2.e7
problem.nse_tol = 1.e2

# microphysics

network.nse_table_interp_linear = 0
