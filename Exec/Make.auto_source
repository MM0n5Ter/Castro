
VPATH_LOCATIONS += $(HYDROSIM_AUTO_SOURCE_DIR)
INCLUDE_LOCATIONS += $(HYDROSIM_AUTO_SOURCE_DIR)



CEXE_sources += extern_parameters.cpp
CEXE_headers += extern_parameters.H
CEXE_headers += extern_type.H

AUTO_BUILD_SOURCES += $(HYDROSIM_AUTO_SOURCE_DIR)/extern_parameters.H
AUTO_BUILD_SOURCES += $(HYDROSIM_AUTO_SOURCE_DIR)/extern_type.H

EXTERN_PARAMETERS := $(foreach dir, $(INCLUDE_LOCATIONS),$(realpath $(wildcard $(dir)/_parameters)))

$(HYDROSIM_AUTO_SOURCE_DIR)/extern_parameters.cpp: $(HYDROSIM_AUTO_SOURCE_DIR)/extern_parameters.H
$(HYDROSIM_AUTO_SOURCE_DIR)/extern_type.H: $(HYDROSIM_AUTO_SOURCE_DIR)/extern_parameters.H

$(HYDROSIM_AUTO_SOURCE_DIR)/extern_parameters.H: $(EXTERN_PARAMETERS)
	@if [ ! -d $(HYDROSIM_AUTO_SOURCE_DIR) ]; then mkdir -p $(HYDROSIM_AUTO_SOURCE_DIR); fi
	$(MICROPHYSICS_HOME)/util/build_scripts/write_probin.py \
           --cxx_prefix $(HYDROSIM_AUTO_SOURCE_DIR)/extern \
           --pa "$(EXTERN_PARAMETERS)"



CEXE_sources += prob_parameters.cpp
CEXE_headers += prob_parameters.H

PROB_PARAMETERS := $(foreach dir, $(Bdirs), $(wildcard $(TOP)/$(dir)/_case_params))
PROB_PARAMETERS += $(wildcard $(PROBLEM_DIR)/_case_params)

$(HYDROSIM_AUTO_SOURCE_DIR)/prob_parameters.cpp: $(HYDROSIM_AUTO_SOURCE_DIR)/prob_parameters.H

AUTO_BUILD_SOURCES += $(HYDROSIM_AUTO_SOURCE_DIR)/prob_parameters.H

$(HYDROSIM_AUTO_SOURCE_DIR)/prob_parameters.H: $(DEFAULT_PROB_PARAMETERS) $(wildcard $(PROB_PARAMETERS))
	@if [ ! -d $(HYDROSIM_AUTO_SOURCE_DIR) ]; then mkdir -p $(HYDROSIM_AUTO_SOURCE_DIR); fi
	PYTHONPATH=$(MICROPHYSICS_HOME)/util/build_scripts $(TOP)/Util/scripts/write_probdata.py \
           -p "$(PROB_PARAMETERS)" \
           --cxx_prefix $(HYDROSIM_AUTO_SOURCE_DIR)/prob \


CEXE_headers += hydrosim_params.H

AUTO_BUILD_SOURCES += $(HYDROSIM_AUTO_SOURCE_DIR)/hydrosim_params.H

CPP_PARAMETERS := $(TOP)/Source/driver/_cpp_parameters

$(HYDROSIM_AUTO_SOURCE_DIR)/runtime_params.cpp: $(HYDROSIM_AUTO_SOURCE_DIR)/hydrosim_params.H

STRUCT_USE_HYDROSIM_CLASS ?= TRUE
PARSE_ARGS :=
ifneq ($(STRUCT_USE_HYDROSIM_CLASS), TRUE)
   PARSE_ARGS += --without-hydrosim-class
endif

$(HYDROSIM_AUTO_SOURCE_DIR)/hydrosim_params.H: $(CPP_PARAMETERS)
	@if [ ! -d $(HYDROSIM_AUTO_SOURCE_DIR) ]; then mkdir -p $(HYDROSIM_AUTO_SOURCE_DIR); fi
	PYTHONPATH=$(MICROPHYSICS_HOME)/util/build_scripts $(TOP)/Source/driver/parse_hydrosim_params.py $(PARSE_ARGS) -o $(HYDROSIM_AUTO_SOURCE_DIR) $(CPP_PARAMETERS)

test_cxx_params: $(HYDROSIM_AUTO_SOURCE_DIR)/hydrosim_params.H


$(HYDROSIM_AUTO_SOURCE_DIR)/state_indices_nd.F90: $(HYDROSIM_AUTO_SOURCE_DIR)/state_indices.H

AUTO_BUILD_SOURCES += $(HYDROSIM_AUTO_SOURCE_DIR)/state_indices.H

$(HYDROSIM_AUTO_SOURCE_DIR)/state_indices.H:
	@if [ ! -d $(HYDROSIM_AUTO_SOURCE_DIR) ]; then mkdir -p $(HYDROSIM_AUTO_SOURCE_DIR); fi
	$(HYDROSIM_HOME)/Source/driver/state_layout_gen.py \
           --defines "$(DEFINES)" \
           --nadv $(NUMADV) \
           --odir $(HYDROSIM_AUTO_SOURCE_DIR) \
           $(HYDROSIM_HOME)/Source/driver/_state_layout

test_variables: $(HYDROSIM_AUTO_SOURCE_DIR)/state_indices.H



CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS +=  $(AMREX_HOME)/Tools/C_scripts


MNAMES := EOS=$(EOS_PATH) NETWORK=$(NETWORK_PATH)
ifeq ($(USE_DIFFUSION), TRUE)
   MNAMES += CONDUCTIVITY=$(CONDUCTIVITY_PATH)
endif

ifeq ($(USE_RAD), TRUE)
   MNAMES += OPACITY=$(OPAC_PATH)
endif

ifeq ($(USE_REACT), TRUE)
   MNAMES += INTEGRATOR=$(INTEGRATOR_DIR) SCREENING=$(SCREEN_METHOD)
endif


objForExecs += $(objEXETempDir)/AMReX_buildInfo.o

.FORCE:
.PHONE: .FORCE

EXTRA_BUILD_INFO :=
ifdef BUILD_GIT_NAME
   EXTRA_BUILD_INFO := --build_git_name "$(BUILD_GIT_NAME)" \
                       --build_git_dir "$(BUILD_GIT_DIR)"
endif

ifeq ($(USE_CUDA), TRUE)
   CUDA_FLAGS := --CUDA_VERSION "$(nvcc_version)"
endif

clean_flags := $(filter-out --jobserver%,$(MAKEFLAGS))
ifeq ($(strip $(clean_flags)),)
  clean_flags = $(MAKEOVERRIDES)
endif

$(objEXETempDir)/AMReX_buildInfo.o: .FORCE
	@if [ ! -d $(objEXETempDir) ]; then mkdir -p $(objEXETempDir); fi
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --CXX_comp_name "$(CXX)" --CXX_flags "$(CXXFLAGS) $(EXTRACXXFLAGS) $(CPPFLAGS) $(includes)" \
          --F_comp_name "$(F90)" --F_flags "$(F90FLAGS)" \
          $(CUDA_FLAGS) \
          --link_flags "$(LDFLAGS)" --libraries "$(libraries)" \
          --make_flags="$(clean_flags)" \
          --MODULES "$(MNAMES)" $(EXTRA_BUILD_INFO) \
          --GIT "$(TOP) $(AMREX_HOME) $(MICROPHYSICS_HOME)"
	$(SILENT) $(CCACHE) $(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $(CXXEXEFLAGS) AMReX_buildInfo.cpp -o $(objEXETempDir)/AMReX_buildInfo.o
	$(SILENT) $(RM) AMReX_buildInfo.cpp
