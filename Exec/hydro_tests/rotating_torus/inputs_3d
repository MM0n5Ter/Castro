# ------------------  INPUTS TO MAIN PROGRAM  -------------------

stop_time = 10.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  0    0    0
geometry.coord_sys   =  0
geometry.prob_lo     = -2.0 -2.0 -2.0
geometry.prob_hi     =  2.0  2.0  2.0
problem.center        =  0.0  0.0  0.0

amr.n_cell           =  64   64   64

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<

hydrosim.lo_bc       =  5 5 5
hydrosim.hi_bc       =  5 5 5

# HYDRO

hydrosim.do_hydro      = 1
hydrosim.small_temp    = 1.e-10
hydrosim.small_dens    = 1.e-10

hydrosim.split_momentum_hydro = 1

hydrosim.clip_small_rho_flux = 1

hydrosim.allow_step_retry = 1

hydrosim.gravity_source_mode = 4
hydrosim.rotation_source_mode = 4

# THERMODYNAMICS

hydrosim.dual_energy_switch_hi = 1.0e-3
hydrosim.dual_energy_switch = 1.0e-4

# GRAVITY

hydrosim.do_gravity_flag           = 1
gravity.gravity_model_name     = ConstantGrav
gravity.uniform_accel       = 0.0
hydrosim.use_central_mass    = 1
hydrosim.point_mass        = 6.0e8
hydrosim.point_mass_correct_solution = 0

# ROTATION

hydrosim.do_frame_spin       = 0
hydrosim.spin_period = 1.0

# TIME STEP CONTROL
hydrosim.cfl            = 0.5     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.05    # scale back initial timestep


# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = -1      # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 32
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = chk_    # root name of checkpoint file
amr.check_int       = 100000  # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = plt_    # root name of plotfile
amr.plot_int        = 100000  # number of timesteps between plotfiles
amr.derive_plot_vars = NONE

# problem initialization

problem.inner_radius = 0.75
problem.outer_radius = 1.50

problem.background_density = 1.0e-8

# Microphysics

# The polytrope constant is selected so that the maximum density is one,
# given our choices for the torus, the point mass, and gamma. If you change
# them in the setup or the inputs file, you must redo this calculation. We
# compute it statically here so that the C++ and Fortran EOS agree.
#
#  K_const = Gconst * point_mass / (TWO * (ONE + polytrope_index) * density_maximum_radius) * &
#            (ONE - density_maximum_radius**2 / (inner_radius * outer_radius))

eos.polytrope_gamma = 1.333333333
eos.polytrope_K     = 0.5112312382075920

