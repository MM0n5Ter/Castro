# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 5000000
stop_time = 1.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic =  1 1
geometry.coord_sys   =  0       # 0 => cart
geometry.prob_lo     =  0    0
geometry.prob_hi     =  1    1
amr.n_cell           =  40   40

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  0  0
hydrosim.hi_bc       =  0  0

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 0

hydrosim.ppm_recon_kind = 1
hydrosim.ppm_temp_mode = 0

hydrosim.use_shock_flatten = 1

hydrosim.riemann_method = 1



# TIME STEP CONTROL

hydrosim.cfl            = 0.5     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1    # scale back initial timestep
hydrosim.change_max     = 1.1     # maximum increase in dt over successive steps

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp
#amr.grid_log         = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 256

amr.refine_criteria = denerr dengrad presserr pressgrad

amr.refine.denerr.value_greater = 3
amr.refine.denerr.field_name = density
amr.refine.denerr.max_level = 3

amr.refine.dengrad.gradient = 0.01
amr.refine.dengrad.field_name = density
amr.refine.dengrad.max_level = 3

amr.refine.presserr.value_greater = 3
amr.refine.presserr.field_name = pressure
amr.refine.presserr.max_level = 3

amr.refine.pressgrad.gradient = 0.01
amr.refine.pressgrad.field_name = pressure
amr.refine.pressgrad.max_level = 3

# CHECKPOINT FILES
amr.check_file      = gresho_chk   # root name of checkpoint file
amr.check_int       = 500       # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = gresho_plt
amr.plot_int        = 500
amr.derive_plot_vars=ALL

# PROBLEM PARAMETERS
problem.rho0 = 1.0

# Mach number of the flow
problem.M0 = 0.1

# EOS
eos.eos_assume_neutral = 1
