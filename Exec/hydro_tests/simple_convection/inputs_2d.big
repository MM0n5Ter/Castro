# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 1000000
stop_time =  10.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0       0
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0       0
geometry.prob_hi     = 8.0     12.0
amr.n_cell           = 512     768

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  2   3
hydrosim.hi_bc       =  2   2

hydrosim.apply_ambient_bc = 1
hydrosim.ambient_bc_axis = 1
hydrosim.ambient_outflow_mode = 1


# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 0
hydrosim.enable_extra_source = 1
hydrosim.do_gravity_flag = 1
hydrosim.do_damping_zone = 1

hydrosim.ppm_recon_kind = 1
hydrosim.gravity_source_mode = 2
hydrosim.use_pressure_slope = 1

gravity.gravity_model_name = ConstantGrav
gravity.uniform_accel   = -2.0

# TIME STEP CONTROL
hydrosim.cfl            = 0.8     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

# SPONGE
hydrosim.damping_upper_density = 0.02
hydrosim.damping_lower_density = 0.002
hydrosim.damping_timescale     = 1.e-2

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 128
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = chk        # root name of checkpoint file
amr.check_int       = 1000       # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file        = plt        # root name of plotfile
amr.plot_int         = 1000       # number of timesteps between plotfiles
amr.derive_plot_vars = ALL

# PROBLEM PARAMETERS
problem.scale_height = 2.0
problem.density_base = 1000.0
problem.low_density_cutoff = 1.e-3

problem.e_rate = 0.5


