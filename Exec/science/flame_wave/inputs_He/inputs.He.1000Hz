# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 9900000
stop_time =  3.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0       0
geometry.coord_sys   = 1                  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0       0
geometry.prob_hi     = 1.84320e5     3.072e4
amr.n_cell           = 1152          192

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  3   1
hydrosim.hi_bc       =  2   2

hydrosim.yl_bc_kind = 1
hydrosim.hse_temp_extrap = 0
hydrosim.hse_bound_temp = 1.e8   # this should match problem.T_star
hydrosim.hse_mirror_vel = 1

hydrosim.apply_ambient_bc = 1
hydrosim.ambient_bc_axis = 1
hydrosim.ambient_outflow_mode = 1

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1
hydrosim.do_frame_spin = 1
hydrosim.do_gravity_flag = 1
hydrosim.do_damping_zone = 1

hydrosim.small_temp = 1.e6
hydrosim.small_dens = 1.e-5

hydrosim.ppm_recon_kind = 1
hydrosim.gravity_source_mode = 2

gravity.gravity_model_name = ConstantGrav
gravity.uniform_accel   = -1.5e14

hydrosim.spin_period = 0.001
hydrosim.rotation_centrifugal_on = 0

hydrosim.conduction_enabled = 1
hydrosim.conduction_cutoff_density_hi = 5.e4
hydrosim.conduction_cutoff_density = 2.e4

hydrosim.conduction_scale_factor = 1.0

hydrosim.burn_rho_min = 1.e2
hydrosim.burn_rho_max = 1.5e7

hydrosim.burn_temp_min = 6.e7

hydrosim.damping_upper_density = 1.e2
hydrosim.damping_lower_density = 1.e0
hydrosim.damping_timescale     = 1.e-7

hydrosim.massfrac_check_tolerance = 0.1
hydrosim.massfrac_check_min_density = 1.0

# TIME STEP CONTROL
hydrosim.cfl            = 0.8     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

hydrosim.allow_step_retry      = 1
hydrosim.subcycle_cap = 16

hydrosim.retry_density_cutoff = 1.0

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 0       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 2       # maximum level number allowed
amr.ref_ratio       = 4 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 16       # block factor in grid generation
amr.max_grid_size   = 128
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = flame_wave_1000Hz_chk        # root name of checkpoint file
amr.check_int       = 250        # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file        = flame_wave_1000Hz_plt        # root name of plotfile
amr.plot_per         = 5.e-3      # number of seconds between plotfiles
amr.derive_plot_vars = ALL

amr.small_plot_file        = flame_wave_1000Hz_smallplt        # root name of plotfile
amr.small_plot_per         = 1.e-4      # number of seconds between plotfiles
amr.small_plot_vars = density Temp
amr.derive_small_plot_vars = abar x_velocity y_velocity z_velocity enuc

# problem initialization

problem.dtemp = 1.2e9
problem.x_half_max = 4.096e4
problem.x_half_width = 2048.e0

problem.density_base = 3.43e6

problem.T_star = 1.e8
problem.T_hi = 2.e8
problem.T_lo   = 8.e6

problem.H_star = 2000.e0
problem.atm_delta  = 50.0

problem.fuel1_name = "helium-4"
problem.fuel1_frac = 1.0e0

problem.ash1_name  = "nickel-56"
problem.ash1_frac = 1.0e0

problem.low_density_cutoff = 1.e-4

problem.cutoff_density = 1.0
problem.max_hse_tagging_level = 3
problem.max_base_tagging_level = 2

problem.X_min = 1.e-2

problem.x_refine_distance = 9.216e4


# Microphysics

integrator.rtol_spec = 1.e-6
integrator.atol_spec = 1.e-6

network.use_tables = 1
