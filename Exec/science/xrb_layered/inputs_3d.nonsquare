# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 50000000
stop_time =  1000.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 1      1       0
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0.0    0.0     0.0
geometry.prob_hi     = 3072   3072    3072
amr.n_cell           = 128    128     256

hydrosim.allow_anisotropic_cells = 1
hydrosim.plane_parallel_domain = 1

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  0   0   3
hydrosim.hi_bc       =  0   0   2

hydrosim.apply_ambient_bc = 1
hydrosim.ambient_bc_axis = 2
hydrosim.ambient_outflow_mode = 1


# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1
hydrosim.enable_extra_source   = 0
hydrosim.do_gravity_flag = 1
hydrosim.do_damping_zone = 1

hydrosim.ppm_recon_kind = 1
hydrosim.gravity_source_mode = 2
hydrosim.use_pressure_slope = 1
hydrosim.slope_rho_cutoff = 1.e4

gravity.gravity_model_name = ConstantGrav
gravity.uniform_accel   = -1.29e14

# burning
hydrosim.burn_rho_min = 1.e2
hydrosim.burn_temp_min = 5.e6


# TIME STEP CONTROL
hydrosim.cfl            = 0.8     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

# SPONGE
hydrosim.damping_upper_density = 1.e3
hydrosim.damping_lower_density = 1.e2
hydrosim.damping_timescale     = 1.0e-7

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 10       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING 
amr.max_level       = 1       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 256
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = xrb_chk    # root name of checkpoint file
amr.check_int       = 1000       # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = xrb_plt    # root name of plotfile
amr.plot_per        = 0.001      
amr.derive_plot_vars = ALL

amr.small_plot_file       = xrb_smallplt    # root name of plotfile
amr.small_plot_per        = 2.e-4       # number of timesteps between plotfiles
amr.small_plot_vars = density Temp
amr.derive_small_plot_vars = abar enuc MachNumber magvel magvort pressure

fab.format = NATIVE_32

# PROBLEM PARAMETERS
problem.model_name =  "toy_atm_hot_3cm.hse"

problem.apply_perturbation = 1

problem.model_shift = 750.0

problem.H_min = -1
problem.He_min = -1

# MICROPHYSICS
integrator.jacobian = 1

integrator.atol_spec = 1.e-6
integrator.rtol_spec = 1.e-6

integrator.X_reject_buffer = 4.0
