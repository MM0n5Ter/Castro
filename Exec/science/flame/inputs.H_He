# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 5000000

stop_time    = 10.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0
geometry.coord_sys   = 0        # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0
geometry.prob_hi     = 3.2768e5
amr.n_cell           = 256

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  3
hydrosim.hi_bc       =  2

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1

hydrosim.small_temp = 1.e6
hydrosim.small_dens = 1.e-5

hydrosim.ppm_recon_kind = 1

hydrosim.conduction_enabled = 1
hydrosim.conduction_cutoff_density = 1.e-2


# TIME STEP CONTROL
hydrosim.cfl            = 0.6     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth


# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 4 2  2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 64      # block factor in grid generation
amr.max_grid_size   = 512
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file      = chk        # root name of checkpoint file
amr.check_int       = 10000      # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = plt        # root name of plotfile
amr.plot_per        = 2.e-2
amr.derive_plot_vars = ALL
hydrosim.keep_omegadot = 1

# problem initialization

problem.rho_fuel = 2.e6
problem.T_fuel = 5.e7

problem.T_ash = 2.0e9

problem.fuel1_name = "hydrogen-1"
problem.X_fuel1 = 0.20

problem.fuel2_name = "helium-4"
problem.X_fuel2 = 0.79

problem.fuel3_name = "oxygen-14"
problem.X_fuel3 = 3.5e-3

problem.fuel4_name = "oxygen-15"
problem.X_fuel4 = 6.5e-3

problem.ash1_name = "nickel-56"
problem.X_ash1 = 1.0

problem.pert_frac = 0.2
problem.pert_delta = 0.05

# refinement

amr.refine_criteria = denerr dengrad

amr.refine.denerr.max_level = 5
amr.refine.denerr.value_greater = 1.e-7
amr.refine.denerr.field_name = density

amr.refine.dengrad.max_level = 5
amr.refine.dengrad.gradient = 0.01
amr.refine.dengrad.field_name = density

# Microphysics

integrator.rtol_spec = 1.e-10
integrator.atol_spec = 1.e-10
