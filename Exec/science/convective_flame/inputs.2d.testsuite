# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 100

stop_time    = 10.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0   0
geometry.coord_sys   = 1        # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0   0
geometry.prob_hi     = 51.2  38.4
amr.n_cell           = 512   384

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  3   3 1
hydrosim.hi_bc       =  2   2 1

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1

hydrosim.diffuse_temp = 1
hydrosim.diffuse_cutoff_density = 1.e-1

hydrosim.small_temp = 1.e-5
hydrosim.small_dens = 1.e-10

hydrosim.do_grav  = 1
hydrosim.do_sponge = 0

hydrosim.ppm_type = 1
hydrosim.ppm_temp_fix = 0

hydrosim.transverse_reset_density = 1

hydrosim.use_flattening = 1

hydrosim.riemann_solver = 0

gravity.gravity_type = UniformField
gravity.const_grav   = -4.2e7

hydrosim.do_rotation = 1
hydrosim.rotational_period = 0.01
hydrosim.rotation_include_centrifugal = 0

# TIME STEP CONTROL
hydrosim.cfl            = 0.5     # cfl number for hyperbolic system
hydrosim.init_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

# SPONGE
hydrosim.sponge_upper_density = 5.0e-8
hydrosim.sponge_lower_density = 1.0e-8
hydrosim.sponge_timescale     = 1.0e-6

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_interval   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING
amr.max_level       = 1       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 32      # block factor in grid generation
amr.max_grid_size   = 96
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.checkpoint_files_output = 1
amr.check_file      = chk        # root name of checkpoint file
amr.check_int       = 1000       # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = plt        # root name of plotfile
amr.plot_int        = -1
amr.plot_per        = 5.e-6
amr.derive_plot_vars = ALL

# problem initialization

problem.cutoff_density = 1.e-8

problem.dtemp = 1.0

problem.dens_base  = 1.0

problem.T_star = 0.75
problem.T_hi   = 1.0
problem.T_lo   = 1.e-2

problem.H_star = 1.25
problem.atm_delta  = 0.2

problem.fuel1_name = fuel
problem.fuel1_frac = 1.0

problem.ash1_name  = inert
problem.ash1_frac = 1.0

problem.low_density_cutoff = 1.e-8

# refinement

amr.refinement_indicators = denerr dengrad

amr.refine.denerr.max_level = 5
amr.refine.denerr.value_greater = 1.e-7
amr.refine.denerr.field_name = density

amr.refine.dengrad.max_level = 5
amr.refine.dengrad.gradient = 0.01
amr.refine.dengrad.field_name = density

# Microphysics

eos.eos_assume_neutral = 1

network.rtilde = 40.0
network.nu = 4.0
network.specific_q_burn = 1.24e8
network.T_burn_ref = 1.0

network.rho_burn_ref = 1.0
network.f_act = 1.2

conductivity.const_conductivity = 5.e9
