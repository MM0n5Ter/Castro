# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 1000000
stop_time =  1000.0

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 1       0
geometry.coord_sys   = 0                  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0.0     0.0
geometry.prob_hi     = 1536.0  4608.0
amr.n_cell           = 256     768

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  0   3
hydrosim.hi_bc       =  0   2

hydrosim.fill_ambient_bc = 1
hydrosim.ambient_fill_dir = 1
hydrosim.ambient_outflow_vel = 1


# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1
hydrosim.add_ext_src   = 0
hydrosim.do_grav = 1
hydrosim.do_sponge = 1

hydrosim.ppm_type = 1
hydrosim.grav_coupling_type = 2
hydrosim.use_pslope = 1
hydrosim.pslope_cutoff_density = 1.e4

gravity.gravity_type = UniformField
gravity.const_grav   = -2.45e14

# TIME STEP CONTROL
hydrosim.cfl            = 0.7     # cfl number for hyperbolic system
hydrosim.init_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

# SPONGE
hydrosim.sponge_upper_density = 5.0e4
hydrosim.sponge_lower_density = 8.0e1
hydrosim.sponge_timescale     = 1.0e-3

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_interval   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp

# REFINEMENT / REGRIDDING 
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 64 
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = xrb_chk    # root name of checkpoint file
amr.check_int       = 1000       # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = xrb_plt    # root name of plotfile
amr.plot_int        = 1000       # number of timesteps between plotfiles
amr.derive_plot_vars = ALL

# PROBLEM PARAMETERS
problem.model_name =  "toy_xrb.hi_dens.hse.tanh.delta_12cm.dx_6cm"

problem.apply_vel_field = 1
problem.velpert_height_loc = 1475.0
problem.velpert_scale = 1.e2
problem.velpert_amplitude = 1.e5
problem.num_vortices = 16

# MICROPHYSICS
integrator.jacobian = 1

integrator.atol_spec = 1.e-6
integrator.rtol_spec = 1.e-6
