problem.tde_separation = 8.0e0
problem.tde_beta = 6.0e0
problem.tde_initial_velocity = 1

problem.interp_temp = 1

problem.relaxation_damping_factor = -1.0e-1
problem.relaxation_density_cutoff = 1.0e3
problem.relaxation_cutoff_time = -1.0e2

problem.stellar_temp = 1.0e7

problem.orbital_eccentricity = 0.0e0
problem.orbital_angle = 0.0e0

