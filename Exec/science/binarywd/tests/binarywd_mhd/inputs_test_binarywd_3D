
############################## HYDROSIM INPUTS ###############################################

############################################################################################
# Problem setup
############################################################################################

max_step = 5                                       # Maximum coarse timestep

geometry.is_periodic = 0 0 0                       # Non-periodic boundary conditions

geometry.coord_sys = 0                             # Cartesian coordinate system

geometry.prob_lo = -5.12e9 -5.12e9 -5.12e9         # Lower boundary limits in physical space
geometry.prob_hi =  5.12e9  5.12e9  5.12e9         # Upper boundary limits in physical space
problem.center =      0.0e0   0.0e0   0.0e0         # System center of mass

hydrosim.cfl = 0.5                                   # CFL number for hyperbolic system
hydrosim.init_dt_shrink = 0.1                           # Scale back initial timestep by this factor
hydrosim.change_max = 1.1                            # Factor by which dt is allowed to change each timestep
amr.subcycling_mode = None                         # Disable subcycling so the relaxation can proceed

############################################################################################
# Boundary conditions
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
############################################################################################

hydrosim.lo_bc = 2 2 2                               # Boundary conditions on lo x, y, and z edges
hydrosim.hi_bc = 2 2 2                               # Boundary conditions on hi x, y, and z edges

#hydrosim.apply_ambient_bc = 1
#hydrosim.clamp_ambient_temperature = 1

############################################################################################ 
# Resolution, gridding and AMR
############################################################################################

amr.n_cell = 48 48 48                              # Number of cells on the coarse grid

amr.max_level = 0                                  # Maximum level number allowed
amr.ref_ratio = 2

amr.max_grid_size = 32                             # Maximum grid size at each level
amr.blocking_factor = 16                           # Grid sizes must be a multiple of this

amr.grid_eff = 0.9                                 # What constitutes an efficient grid

amr.refine_criteria = temperr

amr.refine.temperr.max_level = 4
amr.refine.temperr.field_name = Temp
amr.refine.temperr.value_greater = 2.e8

# Avoid tagging near the domain boundary
hydrosim.tagging_radius_cap = 0.75e0

############################################################################################
# Physics to include
############################################################################################

hydrosim.do_hydro = 1                                # Whether or not to do hydrodynamics
hydrosim.do_gravity_flag = 1                                 # Whether or not to do gravity
hydrosim.do_react = 0                                # Whether or not to do reactions
hydrosim.do_damping_zone = 0                               # Whether or not to apply the sponge
hydrosim.enable_extra_source = 0                             # Whether or not to apply external source terms
hydrosim.extra_source_implicit = 1
hydrosim.do_frame_spin = 0                             # Whether or not to include the rotation source term
hydrosim.spin_period = 100.0                   # Rotational period of the rotating reference frame
hydrosim.rotation_implicit_step = 1                # Implicit rotation coupling

############################################################################################
# PPM options
############################################################################################

hydrosim.ppm_recon_kind = 0                                # Piecewise parabolic with the original limiters (0 is piecewise linear; 2 is new limiters)
hydrosim.use_pressure_slope = 0

hydrosim.use_shock_flatten = 0

hydrosim.ppm_temp_mode = 0                            # Use the EOS in calculation of the edge states going into the Riemann solver
hydrosim.gravity_source_mode = 1 #4                        # How to include the gravity source term in the hydro equations
hydrosim.rotation_source_mode = 4                         # How to include the rotation source term in the hydro equations

# Explicitly limit fluxes to avoid hitting a negative density
hydrosim.clip_small_rho_flux = 0

############################################################################################
# Thermodynamics
############################################################################################

hydrosim.small_temp = 1.e5                           # Minimum allowable temperature (K)
hydrosim.small_dens = 1.e-5                          # Minimum allowable density (g / cm**3)

hydrosim.dual_energy_switch_hi = 1.0e-3                   # Threshold for when to use the internal energy in calculating pressure
hydrosim.dual_energy_switch = 1.0e-1                   # Threshold for when to use (E - K) in updating internal energy

eos.use_eos_coulomb = 0
eos.eos_input_is_constant = 1

hydrosim.background_temp = 1.0e7
hydrosim.background_density = 1.0e-4

############################################################################################
# Gravity
############################################################################################

gravity.gravity_model_name = PoissonGrav                 # Full self-gravity with the Poisson equation
gravity.multipole_order_cap = 6                    # Multipole expansion includes terms up to r**(-multipole_order_cap)
gravity.rel_tol = 1.e-10                           # Relative tolerance for multigrid solver
gravity.no_sync = 1                                # Turn off sync solve for gravity after refluxing

############################################################################################
# Sponge
############################################################################################

hydrosim.damping_lower_radius = 3.840e9
hydrosim.damping_upper_radius = 4.352e9
hydrosim.damping_timescale    = 0.01e0

############################################################################################
# Diagnostics and I/O
############################################################################################

amr.plot_files_output = 0                          # Whether or not to output plotfiles
amr.checkpoint_files_output = 0                    # Whether or not to output checkpoints

amr.check_file = chk                               # Root name of checkpoint file
amr.check_int = 10                                 # Number of timesteps between checkpoints
amr.plot_file = plt                                # Root name of plot file
amr.plot_int = 10                                  # Number of timesteps between plotfiles

amr.v = 1                                          # Control verbosity in Amr.cpp
hydrosim.v = 1                                       # Control verbosity in HydroSim.cpp
gravity.v = 1                                      # Control verbosity in Gravity.cpp
mg.v = 2                                           # Control verbosity in the multigrid solver

#amr.data_log = star_diag.out primary_diag.out secondary_diag.out rotation_diag.out

amr.derive_plot_vars = NONE

############################################################################################
# Problem parameters
############################################################################################

problem.mass_P = 0.90
problem.mass_S = 0.90

problem.problem = 1

problem.roche_radius_factor = 1.0e0

problem.stellar_temp = 1.0e7

problem.relaxation_damping_factor = -1.0e-4
problem.relaxation_density_cutoff = -1.0e10

problem.orbital_eccentricity = 0.0e0
problem.orbital_angle = 0.0e0

problem.stellar_density_threshold = 1.0e0
