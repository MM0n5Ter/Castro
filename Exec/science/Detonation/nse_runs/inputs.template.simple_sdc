# ------------------  INPUTS TO MAIN PROGRAM  -------------------
max_step = 100000
stop_time =  6.e-5

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0 0 0
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     = 0        0    0
geometry.prob_hi     = 3.2768e5
amr.n_cell           = @@NZONES@@

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# 0 = Interior           3 = Symmetry
# 1 = Inflow             4 = SlipWall
# 2 = Outflow            5 = NoSlipWall
# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
hydrosim.lo_bc       =  3   4   4
hydrosim.hi_bc       =  2   4   4

# WHICH PHYSICS
hydrosim.do_hydro = 1
hydrosim.do_react = 1

hydrosim.ppm_recon_kind = 1
hydrosim.ppm_temp_mode = 0

hydrosim.transverse_revert_density = 1

hydrosim.use_shock_flatten = 1

hydrosim.small_temp     = 1.e7

hydrosim.riemann_method = 0

hydrosim.time_scheme = @@method@@
hydrosim.deferred_iters = @@SDC_ITERS@@

# TIME STEP CONTROL
hydrosim.cfl            = @@CFL@@     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.1     # scale back initial timestep
hydrosim.change_max     = 1.05    # scale back initial timestep

hydrosim.burn_dt_energy = @@DTNUC_E@@
hydrosim.allow_step_retry = 1
hydrosim.subcycle_cap = 32

hydrosim.plot_interval_exact = 1

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 1       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp
#amr.grid_log        = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 8       # block factor in grid generation
amr.max_grid_size   = 256
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.check_file      = det_x_chk  # root name of checkpoint file
amr.check_int       = 1000         # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file       = det_x_plt  # root name of plotfile
amr.plot_per = 5.e-6
amr.derive_plot_vars = ALL

# problem initialization

problem.T_l = 4.e9
problem.T_r = 5.e7

problem.dens = 2.e8
problem.cfrac = 0.0
  
problem.smallx = 1.e-10

problem.idir = 1

problem.w_T = 5.e-4
problem.center_T = 0.3

# refinement

amr.refine_criteria = temperr tempgrad

amr.refine.temperr.max_level = 5
amr.refine.temperr.value_greater = 4.e9
amr.refine.temperr.field_name = Temp

amr.refine.tempgrad.max_level = 5
amr.refine.tempgrad.gradient = 1.e8
amr.refine.tempgrad.field_name = Temp

# Microphysics

integrator.call_eos_in_rhs = 1

integrator.rtol_spec = 1.e-6
integrator.atol_spec = 1.e-6
integrator.rtol_enuc = 1.e-6

integrator.jacobian = 3
integrator.ode_max_steps = 1500000
