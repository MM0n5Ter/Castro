# ------------------  INPUTS TO MAIN PROGRAM  -------------------
stop_time = 2000.0
max_step = 30000000

# PROBLEM SIZE & GEOMETRY

geometry.coord_sys = 0                  # 0 => cart, 1 => RZ  2=>spherical

    # >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
    # 0 = Interior           3 = Symmetry
    # 1 = Inflow             4 = SlipWall
    # 2 = Outflow            5 = NoSlipWall
    # >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<

#if AMREX_SPACEDIM == 3

  geometry.is_periodic = 1          1          0
  geometry.prob_lo     = 0          0          0
  geometry.prob_hi     = 10.240e7   10.240e7   15.360e7
  amr.n_cell           = 640        640        960

  hydrosim.apply_ambient_bc = 1
  hydrosim.ambient_bc_axis = 2
  hydrosim.lo_bc = 0   0   3
  hydrosim.hi_bc = 0   0   2

# elif AMREX_SPACEDIM == 2

  geometry.is_periodic = 1          0
  geometry.prob_lo     = 0          0
  geometry.prob_hi     = 30.720e7   15.360e7
  amr.n_cell           = 1920       960

  hydrosim.apply_ambient_bc = 1
  hydrosim.ambient_bc_axis = 1
  hydrosim.lo_bc       =  0   3
  hydrosim.hi_bc       =  0   2

#endif

hydrosim.plane_parallel_domain = 1
hydrosim.hydro_tile_mem_ratio = 3

# WHICH PHYSICS
hydrosim.do_hydro = 1           #hydrodynamics
hydrosim.do_react = 1           #microphysics
hydrosim.do_gravity_flag = 1            #gravity

hydrosim.do_damping_zone = 1          #using sponge
hydrosim.damping_timescale = 1.0e-6
hydrosim.damping_upper_density = 1.0e-1
hydrosim.damping_lower_density =  1.0e-2

hydrosim.ppm_recon_kind = 1
hydrosim.gravity_source_mode = 2
hydrosim.use_pressure_slope = 1
hydrosim.ppm_equil_recon = 1
hydrosim.slope_rho_cutoff = 1.0e-2

hydrosim.use_shock_flatten = 1

hydrosim.small_temp = 5.0e5
hydrosim.small_dens = 5.0e-6
hydrosim.clip_small_rho_flux = 1

hydrosim.retry_density_cutoff = 5.0e-5

hydrosim.allow_step_retry = 1
hydrosim.subcycle_cap = 16

gravity.gravity_model_name = ConstantGrav
gravity.uniform_accel   = -7.06e8

hydrosim.burn_rho_min = 1.0e1
hydrosim.burn_temp_min = 5.0e6

# CONVECTION

hydrosim.drive_initial_convection = 1
hydrosim.convect_drive_reset_period = 2
hydrosim.convect_drive_end_time = 50

# TIME STEP CONTROL
hydrosim.cfl            = 0.85     # cfl number for hyperbolic system
hydrosim.init_dt_shrink    = 0.01     # scale back initial timestep
hydrosim.change_max     = 1.1     # max time step growth

# DIAGNOSTICS & VERBOSITY
hydrosim.sum_step_period   = 25       # timesteps between computing mass
hydrosim.v              = 1       # verbosity in HydroSim.cpp
amr.v                 = 1       # verbosity in Amr.cpp


# REFINEMENT / REGRIDDING
amr.max_level       = 1            # maximum level number allowed
amr.ref_ratio       = 4 2          # refinement ratio
amr.regrid_int      = 2 2         # how often to regrid

#if AMREX_SPACEDIM == 3
  amr.max_grid_size   = 64
  amr.blocking_factor = 32
  amr.grid_eff        = 0.7
  amr.n_error_buf     = 4 2         # number of buffer cells in error est
#elif AMREX_SPACEDIM == 2
  amr.max_grid_size   = 512
  amr.blocking_factor = 32
  amr.n_error_buf     = 4 2         # number of buffer cells in error est
#endif

# CHECKPOINT FILES
amr.check_file      = nova_chk        # root name of checkpoint file
amr.check_per       = -1        # size of timestep between checkpoints
amr.check_int       = 1000         # number of timesteps between checkpoints

# PLOTFILES
amr.plot_file        = nova_plt        # root name of plotfile
amr.plot_per         = 5.0        # set a plot every half second
amr.derive_plot_vars = ALL

amr.small_plot_file        = nova_smallplt        # root name of plotfile
amr.small_plot_per         =  1.0      # number of seconds between plotfiles
amr.small_plot_vars = density Temp
amr.derive_small_plot_vars = abar x_velocity y_velocity X(H1) X(He4) X(C12) X(O16) X(Be7) enuc magvort MachNumber

amr.file_name_digits = 7          # pad step number with zeros if needed

# DATA LOG
amr.data_log = log

# problem initialization

problem.model_name =  "glasner_T7.hse.dx10000.00cm"

problem.apply_vel_field = 0
problem.apply_temp_field = 1
problem.width = 1.0e6
problem.amplitude = 0.05
problem.num_vortices_x = 10
problem.num_vortices_y = 9
problem.width_ratio = 1.8

# Microphysics

integrator.jacobian = 1
integrator.rtol_spec = 1.e-6
integrator.atol_spec = 1.e-10
integrator.rtol_enuc = 1.e-6

integrator.use_burn_retry = 1

# refinement

amr.refine_criteria = dens temp edot

amr.refine.dens.max_level = 2
amr.refine.dens.value_greater = 1.0e2
amr.refine.dens.field_name = density

amr.refine.temp.max_level = 2
amr.refine.temp.value_greater = 3.0e7
amr.refine.temp.field_name = Temp

amr.refine.edot.max_level = 2
amr.refine.edot.value_greater = 1.0e11
amr.refine.edot.field_name = enuc
